{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    ":semanticCommits",
    ":dependencyDashboard",
    ":enablePreCommit"
  ],
  "labels": ["dependencies"],
  "osvVulnerabilityAlerts": true,
  "vulnerabilityAlerts": {
    "enabled": true,
    "labels": ["security"]
  },
  "automerge": false,
  "minimumReleaseAge": "3 days",
  "enabledManagers": [
    "github-actions",
    "gomod",
    "mise",
    "pre-commit",
    "custom.regex"
  ],
  "customManagers": [
    {
      "customType": "regex",
      "description": "Tool versions pinned in a workflow, annotated with a `# renovate:` comment on the preceding line (no built-in manager reads action inputs or env values)",
      "managerFilePatterns": [".github/workflows/*.yml"],
      "matchStrings": [
        "# renovate: datasource=(?<datasource>\\S+) depName=(?<depName>\\S+)(?: versioning=(?<versioning>\\S+))?\\s+\\S+: [\"']?(?<currentValue>[^\"'\\s]+)[\"']?"
      ]
    }
  ],
  "packageRules": [
    {
      "matchManagers": ["github-actions"],
      "groupName": "GitHub Actions",
      "groupSlug": "github-actions"
    },
    {
      "matchManagers": ["gomod"],
      "matchUpdateTypes": ["minor", "patch", "digest"],
      "groupName": "Go dependencies",
      "groupSlug": "go-deps"
    },
    {
      "description": "Go toolchain and indirect module updates change the shipped binary like direct ones, so they get the fix type, which lists them under Fixes in the release notes and calls for a patch release. The :semanticPrefixFixDepsChoreOthers preset of config:recommended gives fix to the require depType only, chore to the rest, so a standard library security fix would be filtered out of the notes.",
      "matchManagers": ["gomod"],
      "matchDepTypes": ["golang", "toolchain", "indirect"],
      "semanticCommitType": "fix"
    },
    {
      "matchManagers": ["mise"],
      "groupName": "mise tools",
      "groupSlug": "mise-tools"
    },
    {
      "matchManagers": ["pre-commit"],
      "groupName": "pre-commit hooks",
      "groupSlug": "pre-commit"
    },
    {
      "matchManagers": ["custom.regex"],
      "groupName": "CI tool versions",
      "groupSlug": "ci-tools"
    },
    {
      "description": "The release tooling (GoReleaser and the GPG import action) runs in the job that signs and publishes: a human reviews each bump, in a pull request of its own.",
      "matchPackageNames": [
        "goreleaser/goreleaser",
        "goreleaser/goreleaser-action",
        "crazy-max/ghaction-import-gpg"
      ],
      "groupName": null,
      "labels": ["dependencies", "release-tooling"]
    }
  ]
}
